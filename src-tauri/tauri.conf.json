{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark Bridge",
  "version": "0.15.0",
  "identifier": "com.sparkbridge.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spark Bridge",
        "width": 540,
        "height": 800,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": true,
        "center": true
      },
      {
        "label": "agent-overlay",
        "title": "Spark Bridge Agent Activity",
        "url": "overlay.html",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "contentProtected": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
